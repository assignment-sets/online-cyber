# Logging ("debug" | "info" | "warn" | "error")
LOG_ENABLED=true
LOG_TO_STDOUT=true
LOG_LEVEL=info

# Supabase (public publishable key is safe for browser; secret key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin / Owner terminal session signing secret (generate a long random string)
ADMIN_SESSION_SECRET=

# Cron job authorization secret (14-day file purge)
CRON_SECRET=

# S3-compatible Object Storage (presigned URLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payment Gateway ("mock" for initial draft)
PAYMENT_PROVIDER=mock
